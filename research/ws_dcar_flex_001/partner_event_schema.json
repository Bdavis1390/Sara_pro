{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldshepherd.invalid/schemas/ws-dcar.partner-event.v0.1.json",
  "title": "WS-DCAR Partner Event Bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "baseline_mw",
    "partner_context",
    "source_objects",
    "points"
  ],
  "properties": {
    "schema_version": {
      "const": "ws-dcar.partner-event/v0.1"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_reduction_mw",
        "response_deadline_s",
        "required_duration_s",
        "max_measured_power_mw"
      ],
      "properties": {
        "requested_reduction_mw": {"type": "number", "minimum": 0},
        "response_deadline_s": {"type": "number", "minimum": 0},
        "required_duration_s": {"type": "number", "minimum": 0},
        "max_measured_power_mw": {"type": "number", "minimum": 0}
      }
    },
    "baseline_mw": {"type": "number", "minimum": 0},
    "max_gap_s": {"type": "number", "minimum": 0},
    "energy_mismatch_tolerance_mwh": {"type": "number", "minimum": 0},
    "partner_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_organization",
        "project_or_dataset_id",
        "measurement_boundary",
        "request_id",
        "authorization_record_id",
        "clock_source",
        "baseline_method",
        "configuration_id",
        "meter_id",
        "authorized",
        "request_provenance_valid",
        "authorization_evidence_valid",
        "clocks_synchronized",
        "baseline_valid",
        "configuration_custody_valid",
        "transformation_history",
        "limitations"
      ],
      "properties": {
        "source_organization": {"type": "string", "minLength": 1},
        "project_or_dataset_id": {"type": "string", "minLength": 1},
        "measurement_boundary": {
          "enum": [
            "device",
            "node",
            "cluster",
            "pdu",
            "facility",
            "grid_boundary"
          ]
        },
        "request_id": {"type": ["string", "null"], "minLength": 1},
        "authorization_record_id": {"type": ["string", "null"], "minLength": 1},
        "clock_source": {"type": ["string", "null"], "minLength": 1},
        "baseline_method": {"type": ["string", "null"], "minLength": 1},
        "configuration_id": {"type": ["string", "null"], "minLength": 1},
        "meter_id": {"type": ["string", "null"], "minLength": 1},
        "authorized": {"type": "boolean"},
        "request_provenance_valid": {"type": "boolean"},
        "authorization_evidence_valid": {"type": "boolean"},
        "clocks_synchronized": {"type": "boolean"},
        "baseline_valid": {"type": "boolean"},
        "configuration_custody_valid": {"type": "boolean"},
        "transformation_history": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "role", "raw_or_derived", "sha256", "media_type"],
        "properties": {
          "object_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "raw_or_derived": {"enum": ["raw", "derived"]},
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp_s",
          "measured_power_mw",
          "telemetry_fresh",
          "meter_provenance_valid",
          "configuration_id",
          "meter_id"
        ],
        "properties": {
          "timestamp_s": {"type": "number", "minimum": 0},
          "measured_power_mw": {"type": "number", "minimum": 0},
          "workload_pause_mw": {"type": "number", "minimum": 0},
          "workload_migration_mw": {"type": "number", "minimum": 0},
          "battery_discharge_mw": {"type": "number", "minimum": 0},
          "onsite_generation_mw": {"type": "number", "minimum": 0},
          "hvac_reduction_mw": {"type": "number", "minimum": 0},
          "telemetry_fresh": {"type": "boolean"},
          "meter_provenance_valid": {"type": "boolean"},
          "configuration_id": {"type": "string", "minLength": 1},
          "meter_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "auxiliary_evidence": {
      "type": "object"
    }
  }
}
