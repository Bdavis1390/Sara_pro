{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Physical-to-Semantic Evidence Chain",
  "type": "object",
  "required": ["chain_id","artifact","stages","claim_state"],
  "properties": {
    "chain_id": {"type":"string"},
    "artifact": {
      "type":"object",
      "required":["artifact_id","repository","physical_state"],
      "properties":{
        "artifact_id":{"type":"string"},
        "repository":{"type":"string"},
        "physical_state":{"type":"string"},
        "date_context":{"type":["string","null"]}
      }
    },
    "stages": {
      "type":"array",
      "items":{
        "type":"object",
        "required":["stage","artifact_id","content_ref","fingerprint"],
        "properties":{
          "stage":{
            "enum":[
              "ARTIFACT","TOMOGRAPHY","SURFACE_SEGMENTATION","VIRTUAL_UNWRAP",
              "INK_DETECTION","GLYPH_IMAGE","TRANSCRIPTION","TEXTUAL_RECONSTRUCTION",
              "TRANSLATION","INTERPRETATION"
            ]
          },
          "artifact_id":{"type":"string"},
          "content_ref":{"type":"string"},
          "fingerprint":{"type":"string"},
          "version":{"type":["string","null"]},
          "model_ref":{"type":["string","null"]},
          "reviewer_ref":{"type":["string","null"]},
          "uncertainty":{"type":["number","null"],"minimum":0,"maximum":1},
          "spatial_ref":{"type":["string","null"]},
          "parent_fingerprints":{"type":"array","items":{"type":"string"}}
        }
      }
    },
    "claim_state":{"type":"array","items":{"type":"string"}}
  }
}