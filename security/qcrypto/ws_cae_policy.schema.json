{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bdavis1390/Sara_pro/worldshepherd-ws-cae-1-review-v0-1/security/qcrypto/ws_cae_policy.schema.json",
  "title": "WS-CAE-1 Consumer Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "minimum_maturity": {
      "type": "string",
      "enum": ["ROADMAP", "DRAFT", "DEVNET", "TESTNET", "MAINNET"],
      "default": "ROADMAP"
    },
    "accepted_pq_authorization_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["NONE", "PLUGGABLE_AUTH_ONLY", "PQ_NON_MAINNET", "PQ_MAINNET"]}
    },
    "accepted_consensus_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["CLASSICAL_OR_UNPROVEN", "PQ_RESEARCH_OR_PARTIAL", "PQ_DEPLOYED"]}
    },
    "require_stable_authority_id": {"type": "boolean", "default": false},
    "require_authenticator_replaceable": {"type": "boolean", "default": false},
    "require_policy_state_documented": {"type": "boolean", "default": false},
    "require_recovery_state_documented": {"type": "boolean", "default": false},
    "require_domain_binding_documented": {"type": "boolean", "default": true},
    "require_evidence_state_documented": {"type": "boolean", "default": true}
  }
}
