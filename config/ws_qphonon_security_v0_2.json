{
  "schema": "WS-QPHONON-SECURITY-V0.2",
  "claim_boundary": "TEN_CONTROL_HARDENING_PROFILE_NOT_A_DEMONSTRATED_10X_RISK_REDUCTION",
  "event_freshness_seconds_max": 300,
  "future_clock_skew_seconds_max": 30,
  "approval_lifetime_seconds_max": 900,
  "required_controls": [
    "STRICT_ECHO_TOP_LEVEL_SCHEMA",
    "SHA256_INTEGRITY_FORMAT",
    "CANONICAL_EVENT_DIGEST",
    "PREVIOUS_EVENT_CHAIN_LINK",
    "EVENT_FRESHNESS_GATE",
    "EVENT_ID_REPLAY_REJECTION",
    "CONFIG_DIGEST_BINDING",
    "FINITE_AND_RANGED_NUMERIC_INPUTS",
    "SEPARATE_HUMAN_EXECUTION_APPROVAL",
    "PINNED_LEAST_PRIVILEGE_CI"
  ],
  "execution_policy": {
    "prime_pass_disposition": "READY_FOR_HUMAN_APPROVAL",
    "execution_pass_disposition": "EXECUTION_ALLOWED",
    "approval_attestation_must_be_verified_externally": true,
    "one_time_approval_id_required": true,
    "approval_binds_experiment_digest": true,
    "approval_binds_config_digest": true
  },
  "supply_chain": {
    "github_actions_must_be_commit_pinned": true,
    "checkout_persist_credentials": false,
    "workflow_permissions": "contents_read_only",
    "no_secrets_required_by_qphonon_ci": true
  }
}
