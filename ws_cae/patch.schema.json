{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WS-CAE Chain Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "chain", "profile", "evidence"],
  "properties": {
    "spec": {"const": "WS-CAE-CHAIN-PATCH-1"},
    "chain": {"type": "string", "minLength": 1},
    "profile": {"$ref": "profile.schema.json"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url", "claim"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
