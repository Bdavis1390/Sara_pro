{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WS-CAE Crypto System Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "asset", "components"],
  "properties": {
    "spec": {"const": "WS-CAE-CRYPTO-SYSTEM-PATCH-1"},
    "asset": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "readiness_state", "critical", "evidence_documented"],
        "properties": {
          "role": {"enum": ["CHAIN_AUTHORITY", "CONSENSUS_VALIDATOR", "ASSET_ISSUER_ADMIN", "BRIDGE_MESSAGING", "CUSTODY_SIGNING", "EXCHANGE_WITHDRAWAL", "WALLET_DEVICE", "RECOVERY", "ORACLE_ADMIN", "ROLLUP_PROVER", "PROTOCOL_ADMIN"]},
          "name": {"type": "string", "minLength": 1},
          "readiness_state": {"enum": ["UNASSESSED", "CLASSICAL_DEPENDENCY", "CRYPTO_AGILE", "PQ_PARTIAL", "PQ_DEPLOYED"]},
          "critical": {"type": "boolean"},
          "evidence_documented": {"type": "boolean"}
        }
      }
    }
  }
}
