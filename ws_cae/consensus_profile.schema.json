{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bdavis1390/Sara_pro/ws-cae-standalone-v0-1/ws_cae/consensus_profile.schema.json",
  "title": "WS-CAE Consensus Continuity Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "consensus_family",
    "mechanism_name",
    "resource_proof",
    "finality_model",
    "participant_auth_primitive",
    "participant_key_agility",
    "local_validation_mode",
    "consensus_pq_state",
    "resource_proof_agility",
    "poc_subtype",
    "evidence"
  ],
  "properties": {
    "subject_id": {"type": "string", "minLength": 1},
    "consensus_family": {
      "enum": ["POW_NAKAMOTO", "POS", "POS_BFT", "DPOS", "NPOS", "BFT", "POA", "PROOF_OF_SPACE_TIME", "PROOF_OF_CAPACITY", "ROLLUP_SEQUENCER", "VALIDITY_PROOF", "FRAUD_PROOF", "HYBRID", "OTHER_NAMED"]
    },
    "mechanism_name": {"type": "string", "minLength": 1},
    "resource_proof": {
      "enum": ["WORK", "STAKE", "AUTHORITY", "STORAGE_SPACE", "CAPACITY", "COVERAGE", "HISTORY_CLOCK", "VALIDITY_PROOF", "FRAUD_PROOF", "NONE", "HYBRID", "OTHER_NAMED"]
    },
    "finality_model": {"type": "string", "minLength": 1},
    "participant_auth_primitive": {"type": "string"},
    "participant_key_agility": {
      "enum": ["UNKNOWN", "FIXED_CLASSICAL", "ROTATABLE_CLASSICAL", "PLUGGABLE_AUTH_ONLY", "PQ_NON_MAINNET", "PQ_MAINNET"]
    },
    "local_validation_mode": {
      "enum": ["FULL_NODE_REEXECUTION", "FULL_NODE_RULE_VALIDATION", "LIGHT_CLIENT_PROOF", "COMMITTEE_ATTESTATION", "VALIDITY_PROOF_VERIFICATION", "FRAUD_PROOF_VERIFICATION", "TRUSTED_SIGNER", "HYBRID", "UNSPECIFIED"]
    },
    "consensus_pq_state": {
      "enum": ["CLASSICAL_OR_UNPROVEN", "PQ_RESEARCH_OR_PARTIAL", "PQ_DEPLOYED"]
    },
    "resource_proof_agility": {"type": "string", "minLength": 1},
    "poc_subtype": {
      "enum": ["", "PROOF_OF_COVERAGE", "PROOF_OF_CAPACITY", "OTHER_NAMED"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url", "claim"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "claim": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
