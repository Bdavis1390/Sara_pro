# Generate each SARA bearer-token value independently, for example:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
SARA_RELAY_TOKEN=replace-with-an-independent-random-token-at-least-24-characters
SARA_ADMIN_TOKEN=replace-with-a-different-random-token-at-least-24-characters
SARA_BIND_HOST=127.0.0.1
SARA_PORT=9530
SARA_HOST_PORT=9530
SARA_DATA_DIR=./data
SARA_MODE=local-verified
SARA_LOG_LEVEL=info
# For an accepted build, set these to the exact tested source commit and release/baseline identifier.
# UNKNOWN/UNVERIFIED must never be represented as an approved release identity.
SARA_BUILD_COMMIT=UNKNOWN
SARA_RELEASE_ID=UNVERIFIED

# PRIME SENTINEL asymmetric authorization verification used by SARA.
# SARA receives PUBLIC keys only. Never put a PRIME SENTINEL private signing key
# or signer bearer token in this general .env file.
# Values are unpadded base64url-encoded raw 32-byte Ed25519 public keys keyed by stable key ID.
# Example shape only; replace with an independently generated PRIME SENTINEL public key before enabling release authorization.
PRIME_SENTINEL_PUBLIC_KEYS_JSON={}
# Monotonic verification-root policy epoch. Leave blank while no PRIME trust
# roots/revocations are configured. Set to 1 when first enabling a trust root,
# then increase for every authorized trust-material rotation. Never decrement.
PRIME_SENTINEL_TRUST_EPOCH=
# Comma-separated key IDs that SARA must reject immediately even if previously trusted.
PRIME_SENTINEL_REVOKED_KEY_IDS=

# Optional G9E high-assurance startup witness.
# Leave disabled unless the G9A-G9D registry checkpoint/witness stack is
# deployed and the witness has been explicitly advanced to the exact current
# registry checkpoint. SARA never auto-advances the witness during startup.
SARA_REQUIRE_REGISTRY_WITNESS=0
REGISTRY_WITNESS_URL=
REGISTRY_WITNESS_CLIENT_TOKEN_FILE=
REGISTRY_WITNESS_PUBLIC_KEY_FILE=
REGISTRY_WITNESS_EXPECTED_FINGERPRINT_SHA256=
# Optional private CA bundle for the witness HTTPS server. System trust is used
# when this is blank. Hostname and certificate verification remain enabled.
REGISTRY_WITNESS_CA_FILE=
REGISTRY_WITNESS_TIMEOUT_SECONDS=5

# Optional host loopback port for the separate, opt-in PRIME SENTINEL profile.
# The signer service is not started by the default SARA Compose deployment.
PRIME_SENTINEL_HOST_PORT=9540
# The signer reads its private key and independent bearer credential from separate
# read-only secret files. Default host paths are:
#   /var/lib/worldshepherd/prime-sentinel/ed25519-private.pem
#   /var/lib/worldshepherd/prime-sentinel/service-token
# Both must be regular files owned by service UID 10001 with no group/other
# permissions. See SECURITY.md and docs/OPERATIONS.md. Host-path overrides, when
# needed for controlled testing, should be supplied to the signer launch process
# rather than persisted in this general SARA environment.
