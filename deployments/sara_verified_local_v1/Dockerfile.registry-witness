FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17

ARG SARA_BUILD_COMMIT=UNKNOWN
ARG SARA_RELEASE_ID=UNVERIFIED

LABEL org.opencontainers.image.title="Worldshepherd SARA Registry Monotonic Witness" \
      org.opencontainers.image.revision="${SARA_BUILD_COMMIT}" \
      org.opencontainers.image.version="${SARA_RELEASE_ID}" \
      worldshepherd.security.boundary="G9D_REMOTE_REGISTRY_WITNESS" \
      worldshepherd.security.independence="deployment-evidence-required"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    REGISTRY_WITNESS_DB_PATH=/var/lib/registry-witness/witness.db

RUN useradd --create-home --uid 10002 witness
WORKDIR /app
COPY pyproject.toml README.md constraints-runtime.txt ./
COPY worldshepherd_sara ./worldshepherd_sara
RUN pip install --no-cache-dir --disable-pip-version-check -c constraints-runtime.txt .
RUN mkdir -p /var/lib/registry-witness \
    && chown -R witness:witness /var/lib/registry-witness /app \
    && chmod 0700 /var/lib/registry-witness

USER witness
EXPOSE 9540
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9540/health', timeout=2)" || exit 1

# This process intentionally serves HTTP inside its deployment boundary.
# Production clients require HTTPS; terminate TLS in a separately configured
# ingress/reverse proxy or replace this command with a TLS-configured ASGI
# launcher. A same-host container does not establish witness independence.
CMD ["python", "-m", "uvicorn", "worldshepherd_sara.registry_witness_service_app:app", "--host", "0.0.0.0", "--port", "9540"]
