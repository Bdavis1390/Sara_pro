# All images MUST be pinned by immutable digest before deployment.
# Examples below are placeholders only; do not deploy them as written.
BITCOIN_CORE_IMAGE=replace-with-bitcoin-core-image@sha256:replace-with-64-hex-digest
ETHEREUM_EXECUTION_IMAGE=replace-with-hoodi-capable-execution-client@sha256:replace-with-64-hex-digest
ETHEREUM_CONSENSUS_IMAGE=replace-with-hoodi-capable-consensus-client@sha256:replace-with-64-hex-digest

BITCOIN_NETWORK=signet
ETHEREUM_NETWORK=hoodi
ETHEREUM_CHAIN_ID=560048

# Observer-first deployment. These MUST remain false in this package.
BITCOIN_MAINNET_ENABLED=false
ETHEREUM_MAINNET_ENABLED=false
LIVE_BITCOIN_BROADCAST_ENABLED=false
ETHEREUM_VALIDATOR_ACTIVATION_ENABLED=false
