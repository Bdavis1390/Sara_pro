{
  "schema": "worldshepherd.connector.read-ticket-policy.v1",
  "ticket_schema": "worldshepherd.connector.read-ticket.v2",
  "execution_mode": "host_connector_handoff",
  "single_use": true,
  "default_ttl_seconds": 60,
  "min_ttl_seconds": 5,
  "max_ttl_seconds": 300,
  "raw_context_in_ticket": false,
  "raw_context_in_policy_envelope": false,
  "context_binding": "canonical_sha256",
  "credential_handling": "outside_sara_broker",
  "write_enabled": false,
  "default_claim_backend": "process_local_memory",
  "default_claim_scope": "process_local_atomic",
  "durable_replay_protection": false,
  "durable_single_host_backend": "sqlite_optional",
  "sqlite_restart_safe": true,
  "sqlite_shared_file_multi_process": true,
  "sqlite_persisted_fields": [
    "ticket_id",
    "ticket_sha256",
    "expires_at",
    "consumed_at"
  ],
  "shared_claim_contract": "IMPLEMENTED_IN_SOFTWARE",
  "shared_claim_reference_store": "process_local_test_only",
  "postgres_claim_adapter": "IMPLEMENTED_IN_SOFTWARE",
  "postgres_claim_primitive": "atomic_update_where_unconsumed_returning",
  "postgres_live_validation": false,
  "multi_worker_live_validation": false,
  "distributed_replay_protection": false,
  "multi_host_consensus": false,
  "claims_boundary": "Default single-use enforcement remains process-local memory and durable_replay_protection remains false for the default path. SQLite is validated for restart-safe single-host claims. The shared-claim contract and credential-blind Postgres adapter are implemented in software, but distributed replay protection remains NOT CURRENTLY CLAIMED until a live shared Postgres deployment passes multi-worker contention, reconnect, failure, and clock-skew validation."
}
