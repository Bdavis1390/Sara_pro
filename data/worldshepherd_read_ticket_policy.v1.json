{
  "schema": "worldshepherd.connector.read-ticket-policy.v1",
  "ticket_schema": "worldshepherd.connector.read-ticket.v2",
  "execution_mode": "host_connector_handoff",
  "single_use": true,
  "default_ttl_seconds": 60,
  "min_ttl_seconds": 5,
  "max_ttl_seconds": 300,
  "raw_context_in_ticket": false,
  "raw_context_in_policy_envelope": false,
  "context_binding": "canonical_sha256",
  "credential_handling": "outside_sara_broker",
  "write_enabled": false,
  "default_claim_backend": "process_local_memory",
  "default_claim_scope": "process_local_atomic",
  "durable_single_host_backend": "sqlite_optional",
  "sqlite_restart_safe": true,
  "sqlite_shared_file_multi_process": true,
  "sqlite_persisted_fields": [
    "ticket_id",
    "ticket_sha256",
    "expires_at",
    "consumed_at"
  ],
  "distributed_replay_protection": false,
  "multi_host_consensus": false,
  "claims_boundary": "Default single-use enforcement remains process-local memory. When explicitly configured, the SQLite adapter provides restart-safe and shared-file multi-process single-host claims. Multi-host and distributed anti-replay require a shared consensus-capable claim service and are not currently claimed."
}
