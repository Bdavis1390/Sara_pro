+++ b/rmf_fleet_adapter_python/src/adapter.cpp
@@
-  .def("interrupted", &agv::RobotUpdateHandle::replan)
-  .def("replan", &agv::RobotUpdateHandle::replan)
+  .def("interrupted", &agv::RobotUpdateHandle::replan,
+    py::call_guard<py::gil_scoped_release>())
+  .def("replan", &agv::RobotUpdateHandle::replan,
+    py::call_guard<py::gil_scoped_release>())
